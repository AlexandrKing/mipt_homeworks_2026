[flake8]
format=wemake
show-source = True
max-line-length = 120
max-complexity = 10
max-local-variables = 12
extend-ignore =
    D100,D101,D102,D103,D104,D105,D106,D107,
    ANN,
    WPS110,WPS111,WPS112,
    WPS201,WPS202,WPS203,WPS204,
    WPS410,WPS411,WPS412,WPS413,WPS414,WPS415,WPS416,WPS417,WPS418,WPS419,WPS420,WPS421,WPS422,WPS423,WPS424,WPS425,WPS426,WPS427,WPS428,WPS429,WPS430,WPS431,WPS432,WPS604
per-file-ignores =
    __init__.py: F401, N999 # исправить
    part3_types_conditions_loops_functions/hw3.py: WPS407
    part3_types_conditions_loops_functions/tests/test_cost_handler.py: WPS218, WPS221
    final_project/gigavibe/cli.py: C901, WPS210, WPS213, WPS223, WPS231, WPS232
    final_project/gigavibe/context.py: WPS231, WPS237
    final_project/gigavibe/llm_client.py: WPS229, WPS237, WPS238, WPS239, WPS301
    final_project/gigavibe/modes.py: E122
    */tests/*: S101, WPS204, N999
